pipeline {
    agent any  
    
    tools {
        jdk 'jdk11'
        maven 'maven3'
        
    }
    
    environment {
        SCANNER_HOME= tool 'sonar-scanner'
    }


    stages {
        stage('git') {
            steps {
                git branch: 'main', changelog: false, poll: false, url: 'https://github.com/Harikona77/Ekart.git'
            }
        }
        
        stage('compile') {
            steps {
                sh 'mvn clean compile -DskipTests=true'
            }
        }
        
        stage('sonarqube') {
            steps {
                
                sh ''' $SCANNER_HOME/bin/sonar-scanner \
                  -Dsonar.projectName=Shopping-Cart \
                  -Dsonar.java.binaries=. \
                  -Dsonar.projectKey=Shopping-Cart \
                  -Dsonar.login=squ_83363ae8022bbc10b5898ceac8075f3a77f57829 \
                  -Dsonar.host.url=http://3.92.84.46:9000/
                '''
            }

        }
        
        stage('build') {
            steps {
                sh 'mvn clean install -DskipTests=true'
            }
        }
        
        stage('dockerbuild') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                        
                        sh "docker build -t shopping:v5 -f docker/Dockerfile ."
                        sh "docker tag shopping:v5 smily786/shopping:v5"
                        sh "docker push smily786/shopping:v5"
 

                    }
                }
            }
        }
        stage('trigger cd ') {
            steps {
                build job: "cd" ,wait: true 
            }
        }
    }
}




pipeline {
    agent any

    stages {
        stage('deploy') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                        
                       sh "docker run -d --name hari -p 8070:8070 smily786/shopping:v5"
                    }
                }
                
            }
        }
    }
}






